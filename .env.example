# ─────────────────────────────────────────────────────────────
# ENVIRONMENT
# ─────────────────────────────────────────────────────────────
# Controls behaviour across the app — logging, error detail etc
# Values: development | production
APP_ENV=development
APP_NAME=ai-data-agent
APP_VERSION=0.1.0

# ─────────────────────────────────────────────────────────────
# POSTGRESQL
# ─────────────────────────────────────────────────────────────
# Used by Docker to create the database on first run
# Used by the backend to connect to the database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agentdb
POSTGRES_USER=agentuser
POSTGRES_PASSWORD=your_postgres_password_here

# Read-only user — used by the AI agent for all queries
# This user cannot INSERT, UPDATE, DELETE or DROP anything
POSTGRES_READONLY_USER=agentreadonly
POSTGRES_READONLY_PASSWORD=your_readonly_password_here

# ─────────────────────────────────────────────────────────────
# REDIS
# ─────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here
# How long to cache a query result (seconds) — 1 hour default
REDIS_CACHE_TTL=3600

# ─────────────────────────────────────────────────────────────
# OPENAI
# ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=4096

# ─────────────────────────────────────────────────────────────
# SECURITY
# ─────────────────────────────────────────────────────────────
# Secret key for signing tokens — generate with: openssl rand -hex 32
SECRET_KEY=your_secret_key_here
# Max requests per user per minute
RATE_LIMIT_PER_MINUTE=20
# Hard limit on rows any query can return
MAX_ROWS_PER_QUERY=1000

# ─────────────────────────────────────────────────────────────
# PGADMIN (dev only)
# ─────────────────────────────────────────────────────────────
PGADMIN_EMAIL=admin@local.dev
PGADMIN_PASSWORD=your_pgadmin_password_here
